FROM golang:1.22-alpine AS builder

WORKDIR /build
COPY fabric-adapter/go.mod fabric-adapter/go.sum ./
RUN go mod download

COPY fabric-adapter/ .
RUN go build -o /fabric-adapter .

FROM alpine:latest
RUN apk add --no-cache ca-certificates
COPY --from=builder /fabric-adapter /usr/local/bin/fabric-adapter
ENTRYPOINT ["/usr/local/bin/fabric-adapter"]
