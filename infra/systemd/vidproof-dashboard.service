[Unit]
Description=VidProof — Streamlit dashboard
After=network.target vidproof-backend.service

[Service]
Type=simple
User=bernard
Group=bernard
WorkingDirectory=/home/bernard/Projects/vidproof
Environment=PATH=/home/bernard/.local/share/mise/shims:/home/bernard/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=streamlit run dashboard/app.py --server.port 8501 --server.address 127.0.0.1 --server.headless true
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
